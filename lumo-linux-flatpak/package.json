{
  "name": "Lumo",
  "version": "2.1.3",
  "description": "Unofficial Lumo for Linux",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "image": "npx electron-icon-builder --input=assets/icons/icon.png --output=assets/icons/build --flatten",
    "build": "npx electron-builder",
    "build-deb": "npx electron-builder --linux deb",
    "build-flatpak": "npx electron-builder --linux flatpak"
  },
  "build": {
    "appId": "io.github.microsoftruinseverything456.lumo",
    "productName": "Lumo",
    "icon": "icon",
    "linux": {
      "target": [
        "deb",
        "flatpak"
      ],
      "icon": "512x512.png",
      "category": "Utility"
    },
    "flatpak": {
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "useWaylandFlags": true,
      "finishArgs": [
        "--unshare=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--filesystem=xdg-download"
      ]
    }
  },
  "devDependencies": {
    "electron": "42.0.0",
    "electron-builder": "26.8.1"
  },
  "overrides": {
    "tar": "*",
    "@tootallnate/once": "*",
    "http-proxy-agent": "*",
    "@electron/rebuild": "*"
  }
}
